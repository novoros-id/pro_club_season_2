# Telegram bot (optional when only the web UI is used)
BOT_TOKEN=

# Generated files directory
USER_FOLDER=./user_data

# Choose exactly one source mode: local or url
VIDEO_SOURCE_MODE=local

# Required when VIDEO_SOURCE_MODE=local
LOCAL_VIDEO_DIR=C:/path/to/videos

# MWS OpenAI-compatible API
MWS_BASE_URL=https://gpt.mwsapis.ru/projects/your-project/openai/v1
MWS_API_KEY=
MWS_LLM_MODEL=gemma-4-31b-it
MWS_EMBEDDING_MODEL=bge-m3
MWS_STT_MODEL=whisper-large-v3

# Request and processing settings
MWS_CONNECT_TIMEOUT=10
MWS_READ_TIMEOUT=600
MWS_EMBEDDING_BATCH_SIZE=64
PARAGRAPH_SIMILARITY_THRESHOLD=0.7
